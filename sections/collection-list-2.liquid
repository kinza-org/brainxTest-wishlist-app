<section class="top-products">
  <div class="tp-container">

    <!-- HEADER -->
    <div class="tp-header">
      <div class="tp-left">
        <button class="tp-tag">See More Categories</button>
        <h2>
          Top-Selling Product<br>
          of the year Collection
        </h2>
      </div>

      <div class="tp-right">
        <p>
          We do not divide our collections to seasons we create new models every week and we in a few items
        </p>
        <button class="tp-shop">Shop Now</button>
      </div>
    </div>

    <!-- CAROUSEL -->
    <div class="tp-carousel-wrapper">

      <div class="tp-carousel" id="tpCarousel">

        <div class="tp-card small">
          <img src="https://via.placeholder.com/180x220" alt="">
          <div class="tp-info">
            <span>Summer Cloth</span>
            <span>23</span>
          </div>
        </div>

        <div class="tp-card tall">
          <img src="https://via.placeholder.com/200x320" alt="">
          <div class="tp-info">
            <span>Water Bottle</span>
            <span>19</span>
          </div>
        </div>

        <div class="tp-card medium">
          <img src="https://via.placeholder.com/200x250" alt="">
          <div class="tp-info">
            <span>Summer Caps</span>
            <span>20</span>
          </div>
        </div>

        <div class="tp-card small">
          <img src="https://via.placeholder.com/180x240" alt="">
          <div class="tp-info">
            <span>Summer Jeans</span>
            <span>33</span>
          </div>
        </div>

      </div>

      <!-- Arrows -->
      <div class="tp-arrows">
        <button class="tp-nav prev">&#8592;</button>
        <button class="tp-nav next">&#8594;</button>
      </div>

    </div>
  </div>
</section>

